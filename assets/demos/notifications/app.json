{
  "schemaVersion": 1,
  "appId": "ceapp-demo-notifications",
  "name": "CEAPP notifications demo",
  "nameI18n": {
    "zh-CN": "CEAPP notifications demo",
    "en-US": "CEAPP notifications demo"
  },
  "version": "1.0.0",
  "description": "CanEngine public bridge demonstration: notifications",
